+/** VIGIL's names for ink music's places: only the words shown change, never the places' own keys. */
+fun placeName(key: String): String = when (key) {
+    "listen" -> "the beat"
+    "ink" -> "the city"
+    "albums" -> "case files"
+    "artists" -> "faces"
