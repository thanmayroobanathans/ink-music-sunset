<?xml version="1.0" encoding="utf-8"?>
<!-- NEON COAST theme (an unofficial build): a striped sun setting over the sea between two palms, on a dusk sky
     (drawable/icon_sky, icon_sunset; made by make_icon.py); the sun alone is the monochrome for themed icons -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/icon_sky" />
    <foreground android:drawable="@drawable/icon_sunset" />
    <monochrome android:drawable="@drawable/icon_sunset_mono" />
</adaptive-icon>
