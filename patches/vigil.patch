+            Row(
+                Modifier.fillMaxWidth()
+                    .then(if (me) Modifier.zIndex(1f).graphicsLayer { translationY = dy }.background(Ink.plate) else Modifier.animateItem())
+                    .padding(vertical = 6.dp),
+                verticalAlignment = Alignment.CenterVertically,
